# HARNESS.manifest — Structural Boundary Declaration
# Read this file FIRST. Before SYSTEM.md, before any project file.
#
# This file declares what is harness infrastructure and what is project content.
# The AI must never confuse the two. The harness is the SYSTEM that manages work.
# The project is the WORK being managed.

harness_version: "3.1"

# --- Role Declaration ---
# The AI reading this is the ORCHESTRATOR of this harness.
# The harness is a project management framework — it is NOT the project itself.
# The project being managed is defined in projects/active_project.md.

role: orchestrator
purpose: "Manage projects using the five core mechanisms defined in this harness."

# --- Harness Files (Infrastructure — Do Not Treat as Project Content) ---
harness_files:
  core:
    - "core/SYSTEM.md"
    - "core/lock/LOCK.md"
    - "core/atomicity/ATOMICITY.md"
    - "core/dependency/DEPENDENCY.md"
    - "core/memory-pipeline/MEMORY-PIPELINE.md"
    - "core/precedence/PRECEDENCE.md"
  templates:
    - "templates/config-skeleton.yaml"
    - "templates/worker-prompt-template.md"
    - "templates/task-template.md"
    - "templates/project-template.md"
    - "templates/rules-template.md"
    - "templates/post-mortem-template.md"
  reference:
    - "reference/VALIDATION.md"
    - "reference/FAILURE-MODES.md"
    - "reference/RESEARCH-PROTOCOL.md"
  case_studies:
    - "case-studies/README.md"
    - "case-studies/01-marketing-funnel/"
    - "case-studies/02-software-feature-ship/"
    - "case-studies/03-client-onboarding/"
    - "case-studies/04-event-planning/"
    - "case-studies/05-compliance-audit/"
  starter:
    - "starter/README.md"
  root:
    - "HARNESS.manifest"
    - "CHANGELOG.md"
    - "VISION.md"
    - "README.md"
    - "LICENSE"

# --- Project Files (Content — Created Per-Project) ---
# These files are generated from templates when a project is created.
# They contain domain-specific content. They are NOT part of the harness.
project_files:
  per_project:
    - "projects/[project-name]/PROJECT.md"
    - "projects/[project-name]/TASK-STATE.yaml"
    - "projects/[project-name]/00-REFERENCE-rules.md"
    - "projects/[project-name]/WORKER-PROMPT.md"
    - "projects/[project-name]/tasks/*.md"
    - "projects/[project-name]/done/*.md"
  shared:
    - "projects/active_project.md"
    - "backlog.md"
    - "memory/DISCOVERIES.md"
    - "memory/LEARNINGS.md"
    - "memory/LEARNINGS-ARCHIVE.md"
    - "config.yaml"

# --- Boundary Rule ---
# If you are unsure whether a file is harness infrastructure or project content:
# 1. Check this manifest.
# 2. If the file is listed under harness_files → it defines HOW work is managed.
# 3. If the file is listed under project_files → it IS the work being managed.
# 4. If the file is not listed → it is project content by default.
#
# Never modify harness_files during project execution.
# Only modify project_files according to the mechanisms defined in the harness.

# --- Startup Validation ---
# Before executing any task, the orchestrator must verify:
startup_checks:
  - "HARNESS.manifest exists and is readable"
  - "config.yaml exists and all required fields are populated"
  - "projects/active_project.md points to a valid project folder"
  - "The active project has: PROJECT.md, TASK-STATE.yaml, 00-REFERENCE-rules.md"
  - "At least one task file exists in the active project's tasks/ folder"

# If any check fails, STOP. Do not proceed. Report what is missing.
# The human operator must resolve structural issues before execution begins.

# --- Verification Checkpoint ---
# After the orchestrator scaffolds a new project (creates config, project files,
# task breakdown), it must PAUSE and present the following for human confirmation:
#
# 1. "Does this project description match your intent?" → Show PROJECT.md objective + scope
# 2. "Do these priority tiers make sense for your domain?" → Show 00-REFERENCE-rules.md tier names
# 3. "Does this task breakdown look right?" → Show TASK-STATE.yaml summary
#
# The operator confirms or corrects. No task execution begins until all three are confirmed.
# This checkpoint is mandatory for new projects. It is not required for resuming existing projects.
